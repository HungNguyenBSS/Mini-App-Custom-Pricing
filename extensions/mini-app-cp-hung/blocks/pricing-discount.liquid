{% comment %} Custom Pricing — hiển thị giá đã áp rule cho sản phẩm hiện tại {% endcomment %}
{% assign product = block.settings.product %}
{% assign rules_json = shop.metafields.custom_pricing.active_rules.value %}

<div
  class="cp-pricing-block"
  data-cp-selector="{{ block.settings.price_selector }}"
>
  <script type="application/json" data-cp-rules>
    {{ rules_json | json }}
  </script>
  <script type="application/json" data-cp-product>
    {
      "tags": {{ product.tags | json }},
      "price": {{ product.price | json }}
    }
  </script>
  <script type="application/json" data-cp-money-format>
    {{ shop.money_format | json }}
  </script>
</div>

<script src="{{ 'pricing.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Custom Pricing",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    {
      "type": "text",
      "id": "price_selector",
      "label": "Price CSS selector",
      "default": ".price-item--regular"
    }
  ]
}
{% endschema %}