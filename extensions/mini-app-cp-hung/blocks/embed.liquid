{% comment %} Custom Pricing app embed — only runs on product pages (PDP). {% endcomment %}
{% if request.page_type == 'product' %}

  <script id="bss-b2b-store-data" type="application/json">
  {
    "shop": {
      "domain": "{{ shop.domain }}",
      "money_format": {{ shop.money_format | json }}
    },
    "product": {{ product | json | base64_encode | json }},
    "custom_pricing": {
      "rules": {{ shop.metafields.custom_pricing.active_rules.value | default: '[]' | json }}
    }
  }
  </script>

  <div
    class="cp-pricing-embed"
    data-cp-selector="{{ block.settings.price_selector }}"
    hidden
  >
  </div>
{% endif %}

{% schema %}
{
  "name": "Custom Pricing",
  "target": "body",
  "javascript": "embed.min.js",
  "settings": [
    {
      "type": "text",
      "id": "price_selector",
      "label": "Price CSS selector",
      "default": ".price-item--regular"
    }
  ]
}
{% endschema %}